@model ErrorViewModel
@{
    ViewData["Title"] = "Қате";
}
<section class="panel delete-confirm-panel">
    <div class="modal-icon danger-modal-icon">!</div>
    <h1>Бет ашылмады</h1>
    <p>Сұрауды өңдеу кезінде қате пайда болды. Біраздан кейін қайта көріңіз.</p>
    @if (Model.ShowRequestId)
    {
        <p class="muted-copy">Сұрау нөмірі: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary-soft" asp-controller="Home" asp-action="Index">Басты бетке оралу</a>
</section>
