@model AidaProfileManager.ViewModels.ProfileCreateViewModel
@{
    ViewData["Title"] = "Профиль қосу";
}
<div class="form-page-heading"><a class="back-link" asp-action="Index">← Профильдер тізіміне оралу</a><div class="eyebrow">ЖАҢА ЖАЗБА</div><h1>Профиль қосу</h1><p class="page-lead">Жаңа пайдаланушыны тіркеу үшін төмендегі ақпаратты толтырыңыз.</p></div>
<div class="form-layout">
    <section class="panel profile-form-panel">
        <form asp-action="Create" method="post" novalidate>
            <partial name="_ProfileCreateFields" model="Model" />
            <div class="form-actions"><a class="btn btn-quiet" asp-action="Index">Бас тарту</a><button class="btn btn-primary-soft" type="submit" data-loading-button>@await Html.PartialAsync("_Icon", "check-circle") Профильді сақтау</button></div>
        </form>
    </section>
    <aside class="form-aside">
        <div class="aside-tip"><div class="tip-icon">@await Html.PartialAsync("_Icon", "shield-check")</div><span class="section-kicker">ҚАУІПСІЗДІК</span><h2>Мәліметтеріңіз қорғалған</h2><p>Құпиясөз ешқашан ашық мәтінмен сақталмайды. Ол ASP.NET Core PasswordHasher арқылы хэштеледі.</p></div>
        <div class="aside-checklist"><strong>Тіркеу кезінде тексеріледі</strong><span>@await Html.PartialAsync("_Icon", "check-circle") Қайталанбайтын username және email</span><span>@await Html.PartialAsync("_Icon", "check-circle") Қауіпсіз құпиясөз талаптары</span><span>@await Html.PartialAsync("_Icon", "check-circle") Браузер және сервер тексерісі</span></div>
    </aside>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
