@model AidaProfileManager.ViewModels.ProfileEditViewModel
@{
    ViewData["Title"] = "Профильді өңдеу";
}
<div class="form-page-heading"><a class="back-link" asp-action="Details" asp-route-id="@Model.Id">← Профильге оралу</a><div class="eyebrow">ЖАЗБАНЫ ӨҢДЕУ</div><h1>Профильді өңдеу</h1><p class="page-lead">Негізгі ақпаратты жаңартыңыз немесе жаңа құпиясөз орнатыңыз.</p></div>
<section class="panel profile-form-panel edit-form-panel">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
        <partial name="_ProfileEditFields" model="Model" />
        <div class="form-actions"><a class="btn btn-quiet" asp-action="Details" asp-route-id="@Model.Id">Бас тарту</a><button class="btn btn-primary-soft" type="submit" data-loading-button>@await Html.PartialAsync("_Icon", "check-circle") Өзгерістерді сақтау</button></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
